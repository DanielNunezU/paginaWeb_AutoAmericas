# Configuracion de produccion para AutosDuitama
# Copia este archivo a .env en el servidor y configura los valores

# Puerto del servidor (puede cambiar segun tu hosting)
PORT=5000

# Ambiente de ejecucion
NODE_ENV=production

# Clave secreta para JWT - IMPORTANTE: Genera una clave unica y segura
# Ejecuta: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu_clave_jwt_super_segura_de_al_menos_64_caracteres

# Credenciales del administrador principal
ADMIN_USERNAME=admin
ADMIN_PASSWORD=contraseña_segura_de_produccion

# URL del frontend (opcional, para CORS)
# FRONTEND_URL=https://autosduitama.com
